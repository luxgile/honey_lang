Person :: struct {
  name: cstring,
  gender: bool,
}

AnimalKind :: enum {
  Dog,
  Cat :: struct { color: cstring, },
  Spider,
}

Animal :: struct {
  kind: AnimalKind,
  name: cstring,
  age: i32,
  owner: Person,

  age_up :: fn(|self) {
    &self.age += 1
  }
}

build_dog :: fn (|) {
  dog := AnimalKind.Dog
}

build_cat :: fn (|) {
  cat := AnimalKind.Cat .{ .color = "Red" }
}

print_member_access :: fn (|) {
  person := Person .{ .name = "Guille", .gender = true }
  animal := Animal .{ .kind = AnimalKind.Cat .{ .color = "Orange "}, .name = "Copper", .age = 8, .owner = person }
  animal.age_up
  printf "my animal is %d years old\n" animal.age
  printf "my owner is %s\n" animal.owner.name
}

print_cat :: fn(|) {
  a := AnimalKind.Cat .{ .color = "orange" }
  match a : AnimalKind.Cat c {
    printf "i'm a cat with color %s\n" c.color
  }
}

main :: fn (|) i32 {
  print_member_access
  print_cat
  0
}
