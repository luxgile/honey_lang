extern printf :: fn (|format: RawString, args: ...)

related_to :: fn (lhs: RawString | rhs: RawString) {
  printf "%s is related to %s \n" lhs rhs
}

+ :: fn (lhs: Int | rhs: Int) Int {
  @i+ lhs rhs
} 

* :: fn (lhs: Int | rhs: Int) Int {
  @i* lhs rhs
} 

+ :: fn (lhs: Float | rhs: Float) Float {
  @f+ lhs rhs
}

== :: fn (lhs: Int | rhs: Int) Bool { 
  @b== lhs rhs
} 

!= :: fn (lhs: Int | rhs: Int) Bool {
  @b!= lhs rhs
}

< :: fn (lhs: Int | rhs: Int) Bool {
  @b< lhs rhs
}

<= :: fn (lhs: Int | rhs: Int) Bool {
  @b<= lhs rhs
}

! :: fn (| rhs: Bool) Bool {
  @b== rhs false
}

Person :: struct {
  name: RawString,
  gender: Bool,
}

AnimalKind :: enum {
  Dog,
  Cat :: struct { color: RawString, },
  Spider,
}

Animal :: struct {
  kind: AnimalKind,
  name: RawString,
  age: Int,
  owner: Person,
}

build_dog :: fn (|) {
  dog := AnimalKind.Dog
}

build_cat :: fn (|) {
  cat := AnimalKind.Cat .{ color = "Red" }
}

main :: fn (|) {
  "Guille" related_to "Ichi"
  my_int := 3 * 5 + 3
  person := Person .{ name = "Guille", gender = true }
  animal := Animal .{ kind = AnimalKind.Cat .{ color = "Orange "},  name = "Copper", age = 8, owner = person }

  printf "my animal is %d years old\n" animal.age
  printf "my owner is %s\n" animal.owner.name

 # match animal.kind : AnimalKind.Cat cat {
 #   printf "I'm a cat with color %s" cat.color
 # }

  my_bool := ! (my_int != 18)
  if my_bool {
    printf "if called!\n"
  }

  i := 0
  loop i < 10 {
    printf "loop %d\n" i
    i = i + 1
  }
    
  printf "3 * 5 + 3 = %d \n" my_int
  
  add := 3.2 + 6.5
  printf "3.2 + 6.5 = %.1f\n" add
}
