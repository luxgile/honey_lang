extern printf :: fn (|format: RawString, args: ...)

related_to :: fn (lhs: RawString | rhs: RawString) {
  printf "%s is related to %s \n" lhs rhs
}

+ :: fn (lhs: Int | rhs: Int) Int {
  @i+ lhs rhs
} 

* :: fn (lhs: Int | rhs: Int) Int {
  @i* lhs rhs
} 

+ :: fn (lhs: Float | rhs: Float) Float {
  @f+ lhs rhs
}

== :: fn (lhs: Int | rhs: Int) Bool { 
  @b== lhs rhs
} 

!= :: fn (lhs: Int | rhs: Int) Bool {
  @b!= lhs rhs
}

< :: fn (lhs: Int | rhs: Int) Bool {
  @b< lhs rhs
}

<= :: fn (lhs: Int | rhs: Int) Bool {
  @b<= lhs rhs
}

! :: fn (| rhs: Bool) Bool {
  @b== rhs false
}

Person :: struct {
  name: RawString,
  gender: Bool,
}

Dog :: struct {
  name: RawString,
  age: Int,
  owner: Person,
}

main :: fn (|) {
  "Guille" related_to "Ichi"
  my_int := 3 * 5 + 3
  person := Person .{ name = "Guille", gender = true }
  dog := Dog .{ name = "Copper", age = 8, owner = person }
  printf "my dog is %d years old\n" dog.age
  printf "my owner is %s\n" dog.owner.name

  my_bool := ! (my_int != 18)
  if my_bool {
    printf "if called!\n"
  }

  i := 0
  loop i < 10 {
    printf "loop %d\n" i
    i = i + 1
  }
    
  printf "3 * 5 + 3 = %d \n" my_int
  
  add := 3.2 + 6.5
  printf "3.2 + 6.5 = %.1f\n" add
}
