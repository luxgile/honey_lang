extern printf := | | format: RawString, args: ...

related_to := lhs: RawString | | rhs: RawString {
  printf "%s is related to %s \n" lhs rhs
}

+ := lhs: Int | Int | rhs: Int {
  @i+ lhs rhs
} 

* := lhs: Int | Int | rhs: Int {
  @i* lhs rhs
} 

+ := lhs: Float | Float | rhs: Float {
  @f+ lhs rhs
}

== := lhs: Int | Bool | rhs: Int { 
  @b== lhs rhs
} 

!= := lhs: Int | Bool | rhs: Int {
  @b!= lhs rhs
}

< := lhs: Int | Bool | rhs: Int {
  @b< lhs rhs
}

<= := lhs: Int | Bool | rhs: Int {
  @b<= lhs rhs
}

! := | Bool | rhs: Bool {
  @b== rhs false
}

Person := struct {
  name: RawString,
  gender: Bool,
}

Dog := struct {
  name: RawString,
  age: Int,
  owner: Person,
}

main := | | {
#  "Guille" related_to "Ichi"
#  my_int := 3 * 5 + 3
  person := Person .{ name = "Guille", gender = true }
  dog := Dog .{ name = "Copper", age = 8, owner = person }
  printf "my dog is %d years old\n" dog.age
  printf "my owner is %s\n" dog.owner.name

