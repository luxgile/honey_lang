extern printf :: fn (|format: RawString, args: ...)

AnimalKind :: enum {
  Dog,
  Cat :: struct { color: RawString, },
  Spider,
}

build_dog :: fn (|) {
  dog := AnimalKind.Dog
  printf "dog built! \n"
}

build_cat :: fn (|) {
  cat := AnimalKind.Cat .{ .color = "Red" }
  printf "cat built! \n"
}

print_cat :: fn(|) {
  a := AnimalKind.Cat .{ .color = "orange" }
  match a : AnimalKind.Cat cat {
    printf "I'm a cat with color %s\n" cat.color
  }
}

main :: fn (|) {
  build_dog
  build_cat
  print_cat
}
