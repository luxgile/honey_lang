extern printf :: fn (|format: cstring, args: ...)
extern scanf :: fn (|format: cstring, input: ^i32)
extern snprintf :: fn (|buffer: cstring, n: i32, format: cstring, args: ...)

extern malloc :: fn(|size: u32) rawptr
extern free :: fn(|ptr: rawptr)

println :: fn(|str: cstring) {
  printf "%s\n" str
}

+ :: fn (lhs: i32 | rhs: i32) i32 {
  @+ lhs rhs
} 

- :: fn (lhs: i32 | rhs: i32) i32 {
  @- lhs rhs
} 

* :: fn (lhs: i32 | rhs: i32) i32 {
  @* lhs rhs
} 

/ :: fn (lhs: i32 | rhs: i32) i32 {
  @/ lhs rhs
} 

% :: fn (lhs: i32 | rhs: i32) i32 {
  @% lhs rhs
} 

+ :: fn (lhs: f32 | rhs: f32) f32 {
  @+ lhs rhs
}

- :: fn (lhs: f32 | rhs: f32) f32 {
  @- lhs rhs
}

* :: fn (lhs: f32 | rhs: f32) f32 {
  @* lhs rhs
} 

/ :: fn (lhs: f32 | rhs: f32) f32 {
  @/ lhs rhs
}

== :: fn (lhs: i32 | rhs: i32) bool { 
  @== lhs rhs
} 

!= :: fn (lhs: i32 | rhs: i32) bool {
  @!= lhs rhs
}

< :: fn (lhs: i32 | rhs: i32) bool {
  @< lhs rhs
}

<= :: fn (lhs: i32 | rhs: i32) bool {
  @<= lhs rhs
}

> :: fn (lhs: i32 | rhs: i32) bool {
  @> lhs rhs
}

>= :: fn (lhs: i32 | rhs: i32) bool {
  @>= lhs rhs
}

< :: fn (lhs: f32 | rhs: f32) bool {
  @< lhs rhs
}

<= :: fn (lhs: f32 | rhs: f32) bool {
  @<= lhs rhs
}

> :: fn (lhs: f32 | rhs: f32) bool {
  @> lhs rhs
}

>= :: fn (lhs: f32 | rhs: f32) bool {
  @>= lhs rhs
}

== :: fn (lhs: bool | rhs: bool) bool { 
  @== lhs rhs
} 

!= :: fn (lhs: bool | rhs: bool) bool {
  @!= lhs rhs
}

and :: fn (lhs: bool | rhs: bool) bool { 
  @&& lhs rhs
} 

or :: fn (lhs: bool | rhs: bool) bool {
  @|| lhs rhs
}

! :: fn (| rhs: bool) bool {
  @== rhs false
}

? :: fn (check: bool | if_true: i32, if_false: i32) i32 {
  if check {
    if_true
  } else {
    if_false
  }
}

+= :: fn (lhs: ^i32 | rhs: i32) {
  ^lhs = @+ ^lhs rhs 
}
