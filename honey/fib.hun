extern printf :: fn (|format: RawString, args: ...)

+ :: fn (lhs: Int | rhs: Int) Int {
  @i+ lhs rhs
} 

- :: fn (lhs: Int | rhs: Int) Int {
  @i- lhs rhs
} 

<= :: fn (lhs: Int | rhs: Int) Bool {
  @b<= lhs rhs
}

fib :: fn(|n: Int) Int {
	if n <= 1 {
		ret 1
  }
	fib (n - 1) + fib (n - 2)
}

main :: fn(|) {
  n := 10
  n = fib n
  printf "%d\n" n
}
