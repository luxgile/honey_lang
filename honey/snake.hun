# extern declarations provided by the user
extern printf :: fn (|format: RawString, args: ...)
extern scanf :: fn (|format: RawString, input: ^Int)
extern snprintf :: fn (|buffer: RawString, n: Int, format: RawString, args: ...)

# Boilerplate functions provided by the user
+ :: fn (lhs: Int | rhs: Int) Int {
  @i+ lhs rhs
}

* :: fn (lhs: Int | rhs: Int) Int {
  @i* lhs rhs
}

+ :: fn (lhs: Float | rhs: Float) Float {
  @f+ lhs rhs
}

/ :: fn (lhs: Float | rhs: Float) Float {
  @f/ lhs rhs
}

== :: fn (lhs: Int | rhs: Int) Bool {
  @b== lhs rhs
}

!= :: fn (lhs: Int | rhs: Int) Bool {
  @b!= lhs rhs
}

< :: fn (lhs: Int | rhs: Int) Bool {
  @b< lhs rhs
}

<= :: fn (lhs: Int | rhs: Int) Bool {
  @b<= lhs rhs
}

! :: fn (| rhs: Bool) Bool {
  @b== rhs false
}

# Define the Point struct for coordinates
Point :: struct {
  x: Int,
  y: Int,
}

# Direction constants
UP := 0
DOWN := 1
LEFT := 2
RIGHT := 3

# Character constants (ASCII values) for drawing the game
SPACE := 32       # ' '
HASH := 35        # '#'
SNAKE_HEAD_CHAR := 79 # 'O'
SNAKE_BODY_CHAR := 111 # 'o'
FOOD_CHAR := 70   # 'F'

# Function to generate food at a random position on the board.
# It ensures the food does not spawn on the snake's body.
generate_food :: fn (
  | snake_body: ^[Point],
  snake_length: Int,
  food_x: ^Int,
  food_y: ^Int,
  board_width: Int,
  board_height: Int,
  food_seed: ^Int # food_seed is now passed as a parameter
) {
  is_on_snake := true
  loop is_on_snake {
    # Simple pseudo-random generation using the passed food_seed.
    # This provides a deterministic but scattered pattern for food placement.
    food_x = (food_seed * 13 + 7) % board_width
    food_y = (food_seed * 17 + 3) % board_height
    food_seed = food_seed + 1

    is_on_snake = false
    i := 0
    loop i < snake_length {
      # Check if the generated food position overlaps with any part of the snake.
      if snake_body[i].x == food_x && snake_body[i].y == food_y {
        is_on_snake = true # If overlap, re-generate food.
      }
      i = i + 1
    }
  }
}

# Function to initialize the game state.
# Sets up the initial snake position, length, direction, and generates the first food item.
init_game :: fn (
  | snake_body: ^[Point],
  snake_length: ^Int,
  snake_head_x: ^Int,
  snake_head_y: ^Int,
  food_x: ^Int,
  food_y: ^Int,
  current_direction: ^Int,
  board_width: Int,
  board_height: Int,
  max_snake_length: Int,
  food_seed: ^Int # food_seed is now passed as a parameter
) {
  # Initial snake position in the middle of the board.
  snake_head_x = board_width / 2
  snake_head_y = board_height / 2
  snake_length = 3 # Start with a snake of length 3.

  # Set initial snake body segments.
  # The head is at index 0, and subsequent segments follow.
  snake_body[0].x = snake_head_x
  snake_body[0].y = snake_head_y
  snake_body[1].x = snake_head_x - 1 # Segment behind the head
  snake_body[1].y = snake_head_y
  snake_body[2].x = snake_head_x - 2 # Segment behind the first body segment
  snake_body[2].y = snake_head_y

  # Initial direction of the snake.
  current_direction = RIGHT

  # Generate the first food item.
  generate_food snake_body snake_length food_x food_y board_width board_height food_seed
}

# Function to draw the game board to the console.
# It renders the walls, snake, and food.
draw_game :: fn (
  | snake_body: ^[Point],
  snake_length: Int,
  food_x: Int,
  food_y: Int,
  board_width: Int,
  board_height: Int
) {
  # Print a separator to distinguish between game frames, as console clearing is not available.
  printf "----------------------------------------\n"

  # Draw the top wall of the board.
  i := 0
  printf "%c" HASH
  loop i < board_width {
    printf "%c" HASH
    i = i + 1
  }
  printf "%c\n" HASH

  # Draw the main board content row by row.
  y := 0
  loop y < board_height {
    printf "%c" HASH # Left wall

    x := 0
    loop x < board_width {
      char_to_print := SPACE # Default to empty space

      # Check if the current cell (x, y) is part of the snake.
      is_snake := false
      j := 0
      loop j < snake_length {
        if snake_body[j].x == x && snake_body[j].y == y {
          is_snake = true
          if j == 0 { # If it's the head of the snake
            char_to_print = SNAKE_HEAD_CHAR
          } else { # If it's a body segment
            char_to_print = SNAKE_BODY_CHAR
          }
        }
        j = j + 1
      }

      # If the cell is not part of the snake, check if it's the food.
      if !is_snake && food_x == x && food_y == y {
        char_to_print = FOOD_CHAR
      }

      printf "%c" char_to_print # Print the determined character for the cell.
      x = x + 1
    }
    printf "%c\n" HASH # Right wall
    y = y + 1
  }

  # Draw the bottom wall of the board.
  i = 0
  printf "%c" HASH
  loop i < board_width {
    printf "%c" HASH
    i = i + 1
  }
  printf "%c\n" HASH
}

# Function to update the snake's direction based on user input.
# It prevents the snake from immediately reversing direction.
update_direction :: fn (
  | current_direction: ^Int,
  input_char: Int
) {
  # ASCII values: 'w'=119, 'a'=97, 's'=115, 'd'=100
  if input_char == 119 { # 'w' (Up)
    if current_direction != DOWN { # Cannot go up if currently going down
      current_direction = UP
    }
  } else if input_char == 115 { # 's' (Down)
    if current_direction != UP { # Cannot go down if currently going up
      current_direction = DOWN
    }
  } else if input_char == 97 { # 'a' (Left)
    if current_direction != RIGHT { # Cannot go left if currently going right
      current_direction = LEFT
    }
  } else if input_char == 100 { # 'd' (Right)
    if current_direction != LEFT { # Cannot go right if currently going left
      current_direction = RIGHT
    }
  }
}

# Function to update the main game state.
# This includes moving the snake, checking for collisions, and handling food consumption.
update_game :: fn (
  | game_over: ^Bool,
  score: ^Int,
  snake_body: ^[Point],
  snake_length: ^Int,
  snake_head_x: ^Int,
  snake_head_y: ^Int,
  food_x: ^Int,
  food_y: ^Int,
  current_direction: Int,
  board_width: Int,
  board_height: Int,
  max_snake_length: Int,
  food_seed: ^Int # food_seed is now passed as a parameter
) {
  # Move snake body: Each segment takes the position of the segment in front of it.
  i := snake_length - 1
  loop i > 0 {
    snake_body[i].x = snake_body[i-1].x
    snake_body[i].y = snake_body[i-1].y
    i = i - 1
  }

  # Move snake head based on the current direction.
  if current_direction == UP {
    snake_head_y = snake_head_y - 1
  } else if current_direction == DOWN {
    snake_head_y = snake_head_y + 1
  } else if current_direction == LEFT {
    snake_head_x = snake_head_x - 1
  } else if current_direction == RIGHT {
    snake_head_x = snake_head_x + 1
  }

  # Update the head's position in the snake_body array.
  snake_body[0].x = snake_head_x
  snake_body[0].y = snake_head_y

  # Check for wall collision.
  if snake_head_x < 0 || snake_head_x >= board_width ||
     snake_head_y < 0 || snake_head_y >= board_height {
    game_over = true # Game over if snake hits a wall.
  }

  # Check for self-collision (snake head hitting its own body).
  # Start checking from the second segment (index 1) to avoid checking head against itself.
  i = 1
  loop i < snake_length {
    if snake_head_x == snake_body[i].x && snake_head_y == snake_body[i].y {
      game_over = true # Game over if snake hits its body.
    }
    i = i + 1
  }

  # Check for food eating.
  if snake_head_x == food_x && snake_head_y == food_y {
    score = score + 10 # Increase score.
    snake_length = snake_length + 1 # Grow the snake.

    # Cap the snake length to prevent array overflow.
    if snake_length > max_snake_length {
      snake_length = max_snake_length
    }

    # Generate new food at a different location.
    generate_food snake_body snake_length food_x food_y board_width board_height food_seed
  }
}

# Main function where the game loop runs.
main :: fn (|) {
  # Define board dimensions and maximum snake length.
  BOARD_WIDTH := 20
  BOARD_HEIGHT := 10
  MAX_SNAKE_LENGTH := 200 # Maximum length for the snake body array.

  # Declare the snake body array.
  # This array holds Point structs for each segment of the snake.
  snake_body_data := [Point, MAX_SNAKE_LENGTH]

  # Initialize game state variables.
  snake_length := 0
  snake_head_x := 0
  snake_head_y := 0

  food_x := 0
  food_y := 0

  current_direction := 0 # Initial direction.

  game_over := false
  score := 0

  food_seed := 0 # Local variable for pseudo-random food generation.

  # Initialize the game.
  init_game &snake_body_data &snake_length &snake_head_x &snake_head_y &food_x &food_y &current_direction BOARD_WIDTH BOARD_HEIGHT MAX_SNAKE_LENGTH &food_seed

  # Main game loop. Continues as long as the game is not over.
  loop !game_over {
    # Draw the current state of the game board.
    draw_game snake_body_data snake_length food_x food_y BOARD_WIDTH BOARD_HEIGHT

    # Prompt the user for input and read it.
    input_char := 0
    printf "Score: %d. Enter direction (w/a/s/d): " score
    scanf "%c" &input_char

    # Consume the newline character left in the input buffer by scanf.
    # This is crucial for subsequent scanf calls to work correctly.
    dummy_char := 0
    scanf "%c" &dummy_char

    # Update the snake's direction based on the user's input.
    update_direction &current_direction input_char

    # Update the game state (move snake, check collisions, handle food).
    update_game &game_over &score &snake_body_data &snake_length &snake_head_x &snake_head_y &food_x &food_y current_direction BOARD_WIDTH BOARD_HEIGHT MAX_SNAKE_LENGTH &food_seed
  }

  # Game over message and final score.
  printf "Game Over! Your final score: %d\n" score
}
