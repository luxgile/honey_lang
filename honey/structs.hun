extern printf :: fn (|format: RawString, args: ...)


Person :: struct {
  name: RawString,
  gender: Bool,

  get_gender :: fn(|self) RawString {
    if self.gender {
      "male"
    } else {
      "female"
    }
  }
}

main :: fn (|) {
  person := Person .{ .name = "El Pepe", .gender = true }
  printf "I'm %s and I'm a %s\n" person.name person.get_gender

  person := Person .{ .name = "Michi", .gender = false }
  printf "I'm %s and I'm a %s\n" person.name person.get_gender
}
